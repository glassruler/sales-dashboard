# Copy to .env and fill in. Never commit .env.

# ---------- Dashboard
APP_PASSWORD=change-me
DATA_PATH=data/sales.csv
# id | en
SUMMARY_LANG=id

# ---------- AI: first provider that works is used; template fallback if none
# gemini | cloudflare
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ---------- Telegram: create a bot with @BotFather; comma-separate several chat ids
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- WhatsApp (Baileys gateway). docker-compose overrides the URL to http://wa:3000
WA_GATEWAY_URL=http://localhost:3000
WA_GATEWAY_TOKEN=change-me-long-random
# 0812..., 62812..., or a group id ...@g.us; comma-separated
WA_TO=

# ---------- Automatic send: cron "minute hour day month weekday" in WIB; empty = off
REPORT_CRON=0 8 * * 1
REPORT_CHANNELS=telegram,whatsapp

# ---------- Only with the optional Caddy profile: domain for automatic HTTPS, or :80
SITE_ADDRESS=:80

# Local port the app listens on (127.0.0.1 only); Nginx proxies the domain to it
APP_PORT=8501
